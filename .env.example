# Contact-form email settings for /api/contact.
# Copy to .env for local use, and set the SAME keys in Vercel:
#   Vercel -> your project -> Settings -> Environment Variables
#
# IMPORTANT: SMTP_PASS is a Google *App Password* (16 characters), NOT the normal
# login password. Google blocks the normal password for SMTP. Generate one at:
#   https://myaccount.google.com/apppasswords  (2-Step Verification must be on)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@sofiacontracting.com
SMTP_PASS=your-16-char-google-app-password
MAIL_TO=info@sofiacontracting.com
SITE_URL=https://sofiasmartcontracting.vercel.app
